# Environment Configuration
# Copy this file to .env and update with your settings

# Application
APP_NAME="PHP MVC Framework"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=your-32-character-secret-key-here

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=virement
DB_USERNAME=root
DB_PASSWORD=Loop@12345678
DB_CHARSET=utf8mb4

# Security
SESSION_LIFETIME=120
CSRF_TOKEN_NAME=_token

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# File Upload
MAX_UPLOAD_SIZE=2048
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Email Configuration
MAIL_DRIVER=mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="Application"

# Cache
CACHE_DRIVER=file
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60